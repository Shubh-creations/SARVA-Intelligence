# Production Multi-Stage Rootless Distroless Dockerfile for FastAPI Backend

# Stage 1: Build & Dependency Installation
FROM python:3.11-slim AS builder
WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev && rm -rf /var/lib/apt/lists/*

COPY . /app
RUN pip install --no-cache-dir --prefix=/install .

# Stage 2: Distroless Production Execution
FROM gcr.io/distroless/python3-debless:nonroot
WORKDIR /app

COPY --from=builder /install /usr/local
COPY --from=builder /app /app

ENV PYTHONPATH=/usr/local/lib/python3.11/site-packages:/app
USER 65532:65532

EXPOSE 8000
ENTRYPOINT ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
